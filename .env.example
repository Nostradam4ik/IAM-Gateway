# ===========================================================================
# Gateway IAM - Environment Configuration
# Copy this file to .env and set REAL values. Never commit a real .env.
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# In production (DEBUG=false) the app FAILS TO START if SECRET_KEY or
# JWT_SECRET_KEY is missing/weak. In DEBUG=true a throwaway secret is
# generated automatically for local development.
# ===========================================================================

# --- Runtime mode ---
DEBUG=false
DEV_MODE=false

# --- Signing / crypto secrets (REQUIRED in production) ---
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=iam-gateway
JWT_AUDIENCE=iam-gateway
BCRYPT_ROUNDS=12

# --- Inbound MidPoint webhook (HMAC-SHA256 shared secret) ---
# Must match the secret MidPoint signs its notifications with.
MIDPOINT_WEBHOOK_SECRET=

# --- MidPoint hub ---
MIDPOINT_URL=http://midpoint-core:8080/midpoint
MIDPOINT_USER=administrator
MIDPOINT_PASSWORD=
MIDPOINT_ENABLED=true
MIDPOINT_VERIFY_SSL=true

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://gateway:gateway@gateway-db:5432/gateway
REDIS_URL=redis://redis:6379/0
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- LDAP / Active Directory ---
LDAP_HOST=openldap
LDAP_PORT=389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=dc=example,dc=com

# --- Odoo ERP ---
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=

# --- SQL target (intranet) ---
INTRANET_DB_URL=postgresql://intranet:intranet@intranet-db:5432/intranet

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=gateway
KEYCLOAK_CLIENT_ID=gateway-client
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Service database passwords (used by docker-compose) ---
POSTGRES_GATEWAY_PASSWORD=
POSTGRES_MIDPOINT_PASSWORD=
POSTGRES_ODOO_PASSWORD=
POSTGRES_INTRANET_PASSWORD=
POSTGRES_KEYCLOAK_PASSWORD=
MIDPOINT_KEYSTORE_PASSWORD=

# --- AI assistant (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
DEEPSEEK_API_KEY=

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@iam-gateway.local
BASE_URL=http://localhost:8000

# --- CORS (JSON array) ---
# CORS_ORIGINS=["http://localhost:3000"]
