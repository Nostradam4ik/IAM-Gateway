# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets & local config (never bake into the image)
.env
.env.*
!.env.example

# Logs / artifacts
*.log
logs/

# VCS & tooling
.git/
.gitignore

# Frontend build context is separate; never ship node_modules/dist via the backend image
frontend/node_modules/
frontend/dist/

# Tests are not needed in the runtime image
tests/
