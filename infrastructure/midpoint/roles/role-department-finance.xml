<?xml version="1.0" encoding="UTF-8"?>
<!--
    Role: Finance Department
    Grants LDAP account + Finance group membership + Odoo Finance access
-->
<role xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
      xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
      oid="20000000-0000-0000-0000-000000000302">

    <name>Department-Finance</name>
    <displayName>Departement Finance</displayName>
    <description>Role pour le departement Finance - acces LDAP + Odoo Finance</description>

    <requestable>true</requestable>
    <riskLevel>high</riskLevel>

    <inducement>
        <construction>
            <resourceRef oid="10000000-0000-0000-0000-000000000001" type="ResourceType"/>
            <kind>account</kind>
            <intent>default</intent>
            <association>
                <ref>ri:ldapGroup</ref>
                <outbound>
                    <expression>
                        <associationTargetSearch>
                            <filter>
                                <q:equal>
                                    <q:path>attributes/ri:cn</q:path>
                                    <q:value>Finance</q:value>
                                </q:equal>
                            </filter>
                            <searchStrategy>onResource</searchStrategy>
                        </associationTargetSearch>
                    </expression>
                </outbound>
            </association>
        </construction>
    </inducement>

    <!-- Odoo access for Finance -->
    <inducement>
        <construction>
            <resourceRef oid="10000000-0000-0000-0000-000000000002" type="ResourceType"/>
            <kind>account</kind>
            <intent>contact</intent>
        </construction>
    </inducement>
</role>
