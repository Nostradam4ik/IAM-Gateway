<?xml version="1.0" encoding="UTF-8"?>
<!--
    Role: Sales Department (Commercial)
    Grants LDAP account + Sales group + Odoo CRM access
-->
<role xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
      xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
      oid="10000000-0000-0000-0000-000000000305">

    <name>Department-Sales</name>
    <displayName>Departement Commercial</displayName>
    <description>Role pour le departement Commercial - acces LDAP + Odoo CRM</description>

    <requestable>true</requestable>
    <riskLevel>medium</riskLevel>

    <inducement>
        <construction>
            <resourceRef oid="10000000-0000-0000-0000-000000000001" type="ResourceType"/>
            <kind>account</kind>
            <intent>default</intent>
            <association>
                <ref>ri:ldapGroup</ref>
                <outbound>
                    <expression>
                        <associationTargetSearch>
                            <filter>
                                <q:equal>
                                    <q:path>attributes/ri:cn</q:path>
                                    <q:value>Sales</q:value>
                                </q:equal>
                            </filter>
                            <searchStrategy>onResource</searchStrategy>
                        </associationTargetSearch>
                    </expression>
                </outbound>
            </association>
        </construction>
    </inducement>

    <!-- Odoo CRM access -->
    <inducement>
        <construction>
            <resourceRef oid="10000000-0000-0000-0000-000000000002" type="ResourceType"/>
            <kind>account</kind>
            <intent>contact</intent>
        </construction>
    </inducement>
</role>
