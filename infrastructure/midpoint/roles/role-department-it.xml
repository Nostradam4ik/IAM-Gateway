<?xml version="1.0" encoding="UTF-8"?>
<!--
    Role: IT Department
    Grants LDAP account + IT group + VPN + Admin groups + Odoo account
-->
<role xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
      xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
      xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
      oid="10000000-0000-0000-0000-000000000304">

    <name>Department-IT</name>
    <displayName>Departement IT</displayName>
    <description>Role pour le departement Informatique - acces LDAP + IT + VPN + Odoo</description>

    <requestable>true</requestable>
    <riskLevel>critical</riskLevel>

    <!-- LDAP Account Inducement -->
    <inducement>
        <construction>
            <resourceRef oid="10000000-0000-0000-0000-000000000001" type="ResourceType"/>
            <kind>account</kind>
            <intent>default</intent>
            <!-- Groupe IT -->
            <association>
                <ref>ri:ldapGroup</ref>
                <outbound>
                    <expression>
                        <associationTargetSearch>
                            <filter>
                                <q:equal>
                                    <q:path>attributes/ri:cn</q:path>
                                    <q:value>IT</q:value>
                                </q:equal>
                            </filter>
                            <searchStrategy>onResource</searchStrategy>
                        </associationTargetSearch>
                    </expression>
                </outbound>
            </association>
            <!-- Groupe VPN -->
            <association>
                <ref>ri:ldapGroup</ref>
                <outbound>
                    <expression>
                        <associationTargetSearch>
                            <filter>
                                <q:equal>
                                    <q:path>attributes/ri:cn</q:path>
                                    <q:value>VPN</q:value>
                                </q:equal>
                            </filter>
                            <searchStrategy>onResource</searchStrategy>
                        </associationTargetSearch>
                    </expression>
                </outbound>
            </association>
            <!-- Groupe Internet -->
            <association>
                <ref>ri:ldapGroup</ref>
                <outbound>
                    <expression>
                        <associationTargetSearch>
                            <filter>
                                <q:equal>
                                    <q:path>attributes/ri:cn</q:path>
                                    <q:value>Internet</q:value>
                                </q:equal>
                            </filter>
                            <searchStrategy>onResource</searchStrategy>
                        </associationTargetSearch>
                    </expression>
                </outbound>
            </association>
        </construction>
    </inducement>

    <!-- Odoo Account Inducement -->
    <inducement>
        <construction>
            <resourceRef oid="10000000-0000-0000-0000-000000000002" type="ResourceType"/>
            <kind>account</kind>
            <intent>default</intent>
        </construction>
    </inducement>
</role>
